# Copy these into .env.local at the repository root (never commit real values).

# The customer's Supabase project ("the bank"): tickets, tokens, customers.
# Use the Transaction pooler string (port 6543) from the project's Connect panel.
CUSTOMER_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Schema of the customer's tables. Leave unset for public.
# CUSTOMER_SCHEMA=public

# Our Supabase project: breaker.column_labels, breaker.sessions, breaker.events.
# Falls back to DATABASE_URL (the dashboard's database) when unset.
BREAKER_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# HTTP API (core/src/server.ts). The plan document says 4000; this project's fixed port is 3150.
PORT=3150
# Bind address. Default 127.0.0.1: the API has no authentication unless BREAKER_API_KEY is set.
# HOST=127.0.0.1
# Extra browser origins allowed to call the API, comma separated. http://localhost:3000 is always allowed.
# BREAKER_CORS_ORIGINS=
# Extra names accepted in the Host header, comma separated, without port.
# BREAKER_ALLOWED_HOSTS=
# Optional. When set, POST /sessions and POST /execute require "Authorization: Bearer <key>".
# BREAKER_API_KEY=

# Clients only (the MCP server, the victim app): where the Breaker API listens.
# BREAKER_URL=http://127.0.0.1:3150
